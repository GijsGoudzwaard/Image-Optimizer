<component type="desktop-application">
   <id>com.github.gijsgoudzwaard.image-optimizer</id>
   <launchable type="desktop-id">com.github.gijsgoudzwaard.image-optimizer.desktop</launchable>
   <translation type="gettext">com.github.gijsgoudzwaard.image-optimizer</translation>
   <metadata_license>CC0-1.0</metadata_license>
   <name>Image Optimizer</name>
   <!-- developer_name has deprecated since AppStream 1.0 -->
   <developer_name>Gijs Goudzwaard</developer_name>
   <developer id="com.github.gijsgoudzwaard">
      <name>Gijs Goudzwaard</name>
   </developer>
   <project_license>MIT</project_license>
   <summary>Shrink images losslessly</summary>
   <description>
      <p>Image Optimizer makes PNG and JPEG files smaller without changing how they look. It rewrites the files you pick in place, so the file you selected is the one that gets smaller.</p>
      <p>The compression is lossless, which means the pixels come out identical and nothing is re-encoded at a lower quality. What comes off is whatever the encoder left on the table, so screenshots and interface images usually gain the most and photos straight out of a camera the least.</p>
      <p>Features:</p>
      <ul>
         <li>Compress PNG and JPEG images without losing quality</li>
         <li>Optimize a whole batch at once, several files at a time</li>
         <li>Works offline, with no account and nothing uploaded</li>
         <li>Keeps the colour profile, so wide-gamut images still look right</li>
         <li>Keeps modification times, so a library sorted by date stays in order</li>
         <li>Quit quickly by pressing Ctrl + Q</li>
      </ul>
   </description>
   <keywords>
      <keyword>compress</keyword>
      <keyword>compressor</keyword>
      <keyword>shrink</keyword>
      <keyword>reduce</keyword>
      <keyword>file size</keyword>
      <keyword>optimize</keyword>
      <keyword>optimise</keyword>
      <keyword>png</keyword>
      <keyword>jpeg</keyword>
      <keyword>jpg</keyword>
      <keyword>photo</keyword>
      <keyword>picture</keyword>
      <keyword>batch</keyword>
      <keyword>lossless</keyword>
   </keywords>
   <url type="homepage">https://github.com/gijsgoudzwaard/image-optimizer</url>
   <url type="bugtracker">https://github.com/gijsgoudzwaard/image-optimizer/issues</url>
   <url type="help">https://github.com/gijsgoudzwaard/image-optimizer/issues</url>
   <url type="vcs-browser">https://github.com/gijsgoudzwaard/image-optimizer</url>
   <url type="contribute">https://github.com/gijsgoudzwaard/image-optimizer</url>
   <url type="donation">https://ko-fi.com/imageoptimizer</url>
   <!-- The snap adopts its Contact link from here. Without one the Snap Store
        listing shows no way to reach the author, which reads as abandonware. -->
   <url type="contact">https://github.com/gijsgoudzwaard/image-optimizer/issues</url>
   <update_contact>gijs.goudzwaard@gmail.com</update_contact>
   <!-- Order matters: the first screenshot is what Flathub shows first and may
        reuse in banners, so it leads with the app doing its job. The empty
        welcome screen is last on purpose. -->
   <screenshots>
      <screenshot type="default">
         <caption>Optimizing a batch of images</caption>
         <image>https://raw.githubusercontent.com/GijsGoudzwaard/Image-Optimizer/master/data/screenshots/optimizing.png</image>
      </screenshot>
      <screenshot>
         <caption>Every image with its old size, new size and savings</caption>
         <image>https://raw.githubusercontent.com/GijsGoudzwaard/Image-Optimizer/master/data/screenshots/completed.png</image>
      </screenshot>
      <screenshot>
         <caption>Drag and drop images to get started</caption>
         <image>https://raw.githubusercontent.com/GijsGoudzwaard/Image-Optimizer/master/data/screenshots/welcome-screen.png</image>
      </screenshot>
   </screenshots>
   <!-- Both taken from the app icon: the sky gradient for light, the night sky
        base for dark. Flathub's quality checks want a light and a dark variant. -->
   <branding>
      <color type="primary" scheme_preference="light">#687ddb</color>
      <color type="primary" scheme_preference="dark">#161650</color>
   </branding>
   <custom>
      <value key="x-appcenter-suggested-price">2</value>
      <value key="x-appcenter-stripe">pk_live_51AhbXkAINoIuuUE3zGg5JG2PvD3IcxMONFdFJZiMawOTGsCzcxxZAREnvLKeoGyMxEVfJpSYfjFzsDZa2bV6eEEb00nj0bUJl8</value>
   </custom>
   <releases>
      <release version="0.4.0" date="2026-08-12">
         <description>
            <ul>
               <li>Image Optimizer no longer asks for access to your whole home folder. It is handed only the images you pick, through the system file chooser, and dragging images in keeps working the same way</li>
               <li>Images in a folder you have no permission to write to are now optimized as well, where they used to be skipped</li>
               <li>Fixed an image that could not be rewritten being reported as optimized, with a saving it never made</li>
            </ul>
         </description>
      </release>
      <release version="0.3.0" date="2026-07-26">
         <description>
            <ul>
               <li>Optimizing a folder full of images is several times faster, because they are now handled at the same time instead of one after another</li>
               <li>Images are compressed further than before, JPEGs in particular</li>
               <li>Colour profiles are now kept, so wide-gamut photos no longer shift colour after optimizing</li>
               <li>Modification times are kept on JPEGs as well, so a photo library sorted by date stays in order</li>
               <li>Fixed a batch stopping early when one file had a quote or a bracket in its name</li>
               <li>Fixed a crash when a selected file turned out not to be an image</li>
               <li>Fixed the button for adding more images being invisible on some systems</li>
               <li>Bitmap files are no longer accepted, because they cannot be optimized in place</li>
               <li>Image Optimizer is now available from the Snap Store, and takes up less room once installed</li>
            </ul>
         </description>
      </release>
      <release version="0.2.0" date="2026-07-25">
         <description>
            <ul>
               <li>Image Optimizer has been rebuilt on GTK4, so it fits in with current elementary OS releases</li>
               <li>Browsing for images now opens the system file chooser</li>
               <li>Drag and drop has been rebuilt for the new toolkit</li>
               <li>File sizes are now formatted the way the rest of your system formats them</li>
               <li>The image list no longer refreshes on a repeating timer, which lowers idle processor use</li>
               <li>Added a donation link for anyone who would like to support development</li>
            </ul>
         </description>
      </release>
      <release version="0.1.25" date="2024-08-21">
         <description>
            <p>Fixed some warnings that happened under the hood.</p>
         </description>
      </release>
      <release version="0.1.22" date="2021-08-21">
         <description>
            <p>Fixed flatpak issue where dragging an image gives a 0 byte sized image and would therefore not be optimized. Also fixed issue where optimizing an image from the home directory would not work.</p>
         </description>
      </release>
